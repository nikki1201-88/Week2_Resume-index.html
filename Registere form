<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Coding Club</title>
</head>
<body>
  <nav><a href="#events">Events</a> | <a href="#register">Register</a></nav>
  <h1>Coding Club</h1>

  <h2 id="events">Upcoming Events</h2>
  <table border="1">
    <caption>Club Events</caption>
    <tr><th>Event</th><th>Date</th><th>Venue</th></tr>
    <tr><td>HTML Workshop</td><td>12 Nov</td><td>Lab 1</td></tr>
    <tr><td>Hackathon</td><td>20 Nov</td><td>Seminar Hall</td></tr>
  </table>

  <h2 id="register">Register</h2>
  <form action="#" method="get">
    <p><label for="name">Name:</label>
      <input type="text" id="name" name="name" required></p>
    <p><label for="email">Email:</label>
      <input type="email" id="email" name="email" required></p>
    <p><label for="pass">Password:</label>
      <input type="password" id="pass" name="pass" required></p>
    <p><label for="dob">Date of birth:</label>
      <input type="date" id="dob" name="dob"></p>
    <p><label for="phone">Phone:</label>
      <input type="tel" id="phone" name="phone"></p>

    <fieldset>
      <legend>Gender</legend>
      <input type="radio" name="gender" value="male" id="m">
      <label for="m">Male</label>
      <input type="radio" name="gender" value="female" id="f">
      <label for="f">Female</label>
      <input type="radio" name="gender" value="other" id="other">
      <label for="other">Other</label>
    </fieldset>

    <fieldset>
      <legend>Interests</legend>
      <input type="checkbox" id="web" name="interests" value="web">
      <label for="web">Web</label>
      <input type="checkbox" id="dsa" name="interests" value="dsa">
      <label for="dsa">DSA</label>
    </fieldset>

    <p><label for="branch">Branch:</label>
      <select id="branch" name="branch">
        <option>B.Tech</option>
        <option>BCA</option>
      </select></p>

    <p><label for="msg">Why do you want to join?</label></p>
    <textarea id="msg" name="message" rows="3"></textarea>
    <br>
    <button type="submit">Register</button>
  </form>
</body>
</html>
